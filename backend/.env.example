# Server Configuration
PORT=8080
SYSTEM_NAME=Meridian Diagnostics LIS/LIMS
NODE_ENV=production

# CORS Configuration (Set to your deployed frontend domain or comma-separated origins)
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (ORACLE DATABASE)
# -----------------------------------------------------------------------------

# Option 1: Local Oracle Database (XE / 19c / 21c / 23ai)
DB_USER=system
DB_PASSWORD=your_local_password
DB_CONNECT_STRING=localhost:1521/XE

# Option 2: Oracle Cloud Always Free Autonomous Database (ATP) - Direct TLS
# DB_USER=ADMIN
# DB_PASSWORD=YourOciPassword123#
# DB_CONNECT_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.region.oraclecloud.com))(connect_data=(service_name=xxxx_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Option 3: Oracle Cloud Autonomous Database with Wallet (mTLS)
# DB_USER=ADMIN
# DB_PASSWORD=YourOciPassword123#
# DB_CONNECT_STRING=dbname_low
# DB_WALLET_LOCATION=/app/wallet
# DB_WALLET_PASSWORD=YourWalletPassword

